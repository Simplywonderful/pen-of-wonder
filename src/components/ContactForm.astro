---
// Posts to Formspree. Without JavaScript it is a normal POST (Formspree's free plan then shows
// its own thank-you page). With JavaScript it validates in place, sends with fetch, keeps what
// was typed if anything fails, and goes to /contact/thanks on success.
// reCAPTCHA stays off in Formspree's settings: it sets Google cookies. The _gotcha field is the honeypot.
import Todo from "./Todo.astro";
import { contact } from "../data/pages/contact";
import { roles, site, placeholders } from "../data/site";

const f = contact.form;
const action = `https://formspree.io/f/${site.formspreeId ?? "not-connected"}`;
---

<form
  class="contact-form"
  action={action}
  method="POST"
  data-connected={site.formspreeId ? "true" : "false"}
  data-errors={JSON.stringify(f.errors)}
  data-sending={f.sending}
>
  {
    !site.formspreeId && (
      <p class="mb-6 text-sm">
        <Todo label={placeholders.formspreeId} />
      </p>
    )
  }

  <div class="form-summary" role="alert" tabindex="-1" hidden></div>

  <div class="field">
    <label for="cf-name">{f.name}</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-error" />
    <p id="cf-name-error" class="field__error" hidden></p>
  </div>

  <div class="field">
    <label for="cf-email">{f.email}</label>
    <input
      id="cf-email"
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      aria-describedby="cf-email-error"
    />
    <p id="cf-email-error" class="field__error" hidden></p>
  </div>

  <fieldset class="field" aria-describedby="cf-role-error">
    <legend>{f.role}</legend>
    <div class="choices">
      {
        roles.map((r, i) => (
          <label class="choice">
            <input type="radio" name="role" value={r.value} required={i === 0} />
            <span>{r.label}</span>
          </label>
        ))
      }
    </div>
    <p id="cf-role-error" class="field__error" hidden></p>
  </fieldset>

  <div class="field">
    <label for="cf-message">{f.message}</label>
    <p id="cf-message-hint" class="field__hint">{f.messageHint}</p>
    <textarea id="cf-message" name="message" rows="6" required aria-describedby="cf-message-hint cf-message-error"
    ></textarea>
    <p id="cf-message-error" class="field__error" hidden></p>
  </div>

  <div class="field">
    <label for="cf-link">{f.link}</label>
    <p id="cf-link-hint" class="field__hint">{f.linkHint}</p>
    <input
      id="cf-link"
      name="file_link"
      type="url"
      inputmode="url"
      autocomplete="url"
      placeholder="https://"
      aria-describedby="cf-link-hint cf-link-error"
    />
    <p id="cf-link-error" class="field__error" hidden></p>
  </div>

  <div class="honeypot" aria-hidden="true">
    <label for="cf-gotcha">Leave this empty</label>
    <input id="cf-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_subject" value="New message from the Pen of Wonder Research website" />

  <p class="mt-8">
    <button class="btn btn-primary" type="submit">{f.submit}</button>
  </p>
</form>

<style>
  .contact-form {
    max-width: 36rem;
  }
  .field {
    margin-top: 1.5rem;
    border: 0;
    padding: 0;
  }
  .field label,
  .field legend {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .field__hint {
    margin: -0.15rem 0 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="url"],
  .field textarea {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-xs);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .field [aria-invalid="true"] {
    border-width: 2px;
    border-color: var(--color-text);
  }
  .field__error {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .field__error::before {
    content: "Check this: ";
    font-weight: 400;
  }
  .choices {
    display: grid;
    gap: 0.25rem;
  }
  .field .choice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 400;
    margin: 0;
    cursor: pointer;
  }
  .choice input {
    width: 1.15rem;
    height: 1.15rem;
  }
  .form-summary {
    padding: 0.9rem 1rem;
    border: 2px solid var(--color-text);
    background: var(--color-panel);
    font-weight: 600;
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  type Errors = Record<string, string>;

  const form = document.querySelector<HTMLFormElement>(".contact-form");
  if (form) {
    const errors: Errors = JSON.parse(form.dataset.errors ?? "{}");
    const summary = form.querySelector<HTMLElement>(".form-summary")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonLabel = button.textContent;
    form.noValidate = true;

    // Each door's button sends people here as ?as=researcher, editing-firm or student.
    const preset = new URLSearchParams(location.search).get("as");
    const presetInput = form.querySelector<HTMLInputElement>(`input[name="role"][value="${CSS.escape(preset ?? "")}"]`);
    if (presetInput) presetInput.checked = true;

    const setError = (id: string, control: HTMLElement | null, message: string | null) => {
      const el = form.querySelector<HTMLElement>(`#${id}-error`);
      if (!el) return;
      el.textContent = message ?? "";
      el.hidden = !message;
      control?.setAttribute("aria-invalid", message ? "true" : "false");
    };

    const validate = () => {
      const name = form.elements.namedItem("name") as HTMLInputElement;
      const email = form.elements.namedItem("email") as HTMLInputElement;
      const message = form.elements.namedItem("message") as HTMLTextAreaElement;
      const link = form.elements.namedItem("file_link") as HTMLInputElement;
      const role = form.querySelector<HTMLInputElement>('input[name="role"]:checked');
      const firstRole = form.querySelector<HTMLInputElement>('input[name="role"]');

      const checks: [string, HTMLElement | null, string | null][] = [
        ["cf-name", name, name.value.trim() ? null : errors.name],
        [
          "cf-email",
          email,
          !email.value.trim() ? errors.email : email.validity.typeMismatch ? errors.emailFormat : null,
        ],
        ["cf-role", firstRole, role ? null : errors.role],
        ["cf-message", message, message.value.trim() ? null : errors.message],
        ["cf-link", link, link.value.trim() && !/^https?:\/\/\S+\.\S+/.test(link.value.trim()) ? errors.link : null],
      ];
      checks.forEach(([id, control, msg]) => setError(id, control, msg));
      const firstBad = checks.find(([, , msg]) => msg);
      return firstBad ? (firstBad[1] as HTMLElement) : null;
    };

    const showSummary = (message: string | null) => {
      summary.textContent = message ?? "";
      summary.hidden = !message;
      if (message) summary.focus();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const firstBad = validate();
      if (firstBad) {
        showSummary(errors.summary);
        firstBad.focus();
        return;
      }
      if (form.dataset.connected !== "true") {
        showSummary(errors.notConnected);
        return;
      }

      button.disabled = true;
      button.textContent = form.dataset.sending ?? buttonLabel;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(String(response.status));
        location.assign("/contact/thanks");
      } catch {
        showSummary(errors.network);
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    });
  }
</script>
