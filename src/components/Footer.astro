---
import ThemeToggle from "./ThemeToggle.astro";
import Todo from "./Todo.astro";
import { site, placeholders } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-rule">
  <div class="mx-auto grid max-w-(--container-sheet) gap-8 px-4 py-10 text-sm md:px-8 lg:grid-cols-[minmax(0,44rem)_minmax(12rem,15rem)] lg:gap-x-16 lg:px-12">
    <div class="space-y-4">
      <p class="font-serif text-lg">{site.name}</p>
      <p class="max-w-[60ch] text-muted">
        {site.businessLine}
        {site.cacNumber ? ` Business name number ${site.cacNumber}.` : <> <Todo label={placeholders.cacNumber} /></>}
      </p>
      <p class="text-muted">
        Based in {site.city}, {site.country}, {site.timezone}. I reply {site.replyTime}.
      </p>
    </div>
    <div class="space-y-6">
      <ul class="space-y-2">
        <li><a href={site.whatsapp.link}>WhatsApp {site.whatsapp.display}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      <ul class="space-y-2">
        <li><a href="/academic-integrity">Academic Integrity Policy</a></li>
        <li><a href="/privacy">Privacy notice</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
      <ThemeToggle />
    </div>
    <p class="text-muted lg:col-span-2">© {year} Pen of Wonder Consults</p>
  </div>
</footer>
