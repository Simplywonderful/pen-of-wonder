---
// One of only two hand-drawn proof marks on the site (BS 5261 style). Contact uses the ring
// round "three changes"; the 404 page uses the caret. Do not add a third: see DESIGN.md.
interface Props {
  mark: "ring" | "caret";
}
const { mark } = Astro.props;
---

{
  mark === "ring" ? (
    <span class="pen pen--ring">
      <slot />
      <svg class="pen__svg" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M24 33c3-14 41-24 86-24 44 0 79 7 81 21 2 15-36 23-87 23C55 53 9 47 8 31 7 19 37 9 82 6c15-1 31-1 44 0" />
      </svg>
    </span>
  ) : (
    <span class="pen pen--caret" aria-hidden="true">
      <svg class="pen__svg" viewBox="0 0 40 40" focusable="false">
        <path d="M5 34c5-9 10-19 15-29 3 9 9 19 15 28" />
      </svg>
    </span>
  )
}

<style>
  .pen {
    position: relative;
    display: inline-block;
  }
  .pen__svg {
    position: absolute;
    overflow: visible;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .pen--ring .pen__svg {
    inset: -0.45em -0.6em;
    width: calc(100% + 1.2em);
    height: calc(100% + 0.9em);
  }
  .pen--ring .pen__svg path {
    vector-effect: non-scaling-stroke;
  }
  .pen--caret {
    width: 1.1em;
    height: 1em;
    vertical-align: -0.35em;
  }
  .pen--caret .pen__svg {
    inset: 0;
    width: 100%;
    height: 100%;
    stroke-width: 3;
  }
</style>
