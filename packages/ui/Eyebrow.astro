---
// A short uppercase label in a pill, above a heading (DESIGN.md 20.1, D7). On the page it is
// outlined in the world accent; on a dark band it is a Cream outline, so gold stays once per layout.
interface Props {
  tone?: "page" | "band";
  class?: string;
}
const { tone = "page", class: className } = Astro.props;
---

<p class:list={["eyebrow", `eyebrow--${tone}`, className]}><slot /></p>

<style>
  .eyebrow {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .eyebrow--page {
    color: var(--color-world-accent);
  }
  .eyebrow--band {
    color: var(--color-band-ink);
    border-color: color-mix(in oklch, var(--color-band-ink) 55%, transparent);
  }
</style>
