---
// A studio portrait shown as a print mounted on the page. The mount stays paper-coloured in dark
// mode, so a white-backed photo reads as a print clipped to the manuscript, not a glaring hole.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  position?: string;
  priority?: boolean;
  sizes: string;
  class?: string;
}

const { src, alt, width, height, position = "center", priority = false, sizes, class: className } = Astro.props;
---

<figure class:list={["mount", className]}>
  <Picture
    src={src}
    alt={alt}
    width={width}
    height={height}
    fit="cover"
    position={position}
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    widths={[320, 480, 640].filter((w) => w < width).concat(width)}
    sizes={sizes}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding={priority ? "sync" : "async"}
  />
</figure>

<style>
  .mount {
    margin: 0;
    padding: 0.75rem 0.75rem 1.75rem;
    background: var(--color-mount);
    border: 1px solid var(--color-rule);
  }
  .mount :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-light);
  }
</style>
