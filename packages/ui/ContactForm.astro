---
// One email form for every world, posting to Formspree. It asks which part of Pen of Wonder the
// message is for, preset from ?world= or the site it sits on, and puts that world in the subject.
// Without JavaScript it is a normal POST (Formspree's free plan then shows its own thank-you page).
// With JavaScript it validates in place, sends with fetch, keeps what was typed if anything fails,
// and goes to /contact/thanks on success. reCAPTCHA stays off (it sets Google cookies); _gotcha is
// the honeypot. Nothing is stored on the site.
import { contact, contactPlaceholders } from "@pow/config/contact";
import { menuWorlds, world as getWorld, type WorldId } from "@pow/config/worlds";
import Todo from "./Todo.astro";

interface Props {
  world: WorldId;
  /** Ask which world. Off on a world's own contact page, where the answer is already known. */
  askWorld?: boolean;
  intent?: "enquiry" | "notify";
}
const { world: id, askWorld = true, intent = "enquiry" } = Astro.props;

const choices = [...menuWorlds.map((w) => ({ value: w.id, label: w.status === "soon" ? `${w.label} (opening soon)` : w.label })), { value: "main", label: "Not sure yet" }];
const subjectFor = (w: WorldId) => `${w === "main" ? "Pen of Wonder" : getWorld(w).name}: new ${intent === "notify" ? "notify-me request" : "message"} from the website`;
const action = `https://formspree.io/f/${contact.formspreeId ?? "not-connected"}`;

const errors = {
  name: "Please add your name so we know who we're writing to.",
  email: "Please add your email so we can reply.",
  emailFormat: "That email address looks incomplete. Please check it.",
  world: "Please choose what your message is about, or Not sure yet.",
  message: "Please add a short message, even one line.",
  link: "That link doesn't look complete. It should start with https://",
  summary: "A few things need fixing before this can be sent.",
  network: "Your message didn't send. Please check your connection and try again; nothing you typed has been lost.",
  notConnected: "The form isn't connected yet, so nothing was sent. Please use WhatsApp for now; nothing you typed has been lost.",
};
---

<form
  class="contact-form"
  action={action}
  method="POST"
  data-connected={contact.formspreeId ? "true" : "false"}
  data-errors={JSON.stringify(errors)}
  data-subjects={JSON.stringify(Object.fromEntries(choices.map((c) => [c.value, subjectFor(c.value as WorldId)])))}
>
  {
    !contact.formspreeId && (
      <p class="mb-6 text-sm">
        <Todo label={contactPlaceholders.formspreeId} />
      </p>
    )
  }

  <div class="form-summary" role="alert" tabindex="-1" hidden></div>

  <div class="field">
    <label for="cf-name">Your name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-error" />
    <p id="cf-name-error" class="field__error" hidden></p>
  </div>

  <div class="field">
    <label for="cf-email">Email address</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="cf-email-error" />
    <p id="cf-email-error" class="field__error" hidden></p>
  </div>

  {
    askWorld ? (
      <fieldset class="field" aria-describedby="cf-world-error">
        <legend>What is it about?</legend>
        <div class="choices">
          {choices.map((c, i) => (
            <label class="choice">
              <input type="radio" name="world" value={c.value} required={i === 0} checked={c.value === id} />
              <span>{c.label}</span>
            </label>
          ))}
        </div>
        <p id="cf-world-error" class="field__error" hidden />
      </fieldset>
    ) : (
      <input type="hidden" name="world" value={id} />
    )
  }

  <div class="field">
    <label for="cf-message">Message</label>
    <p id="cf-message-hint" class="field__hint">What you need, and any deadline.</p>
    <textarea id="cf-message" name="message" rows="6" required aria-describedby="cf-message-hint cf-message-error"></textarea>
    <p id="cf-message-error" class="field__error" hidden></p>
  </div>

  <div class="field">
    <label for="cf-link">Link to a file (optional)</label>
    <p id="cf-link-hint" class="field__hint">A Google Drive, Dropbox or OneDrive link with view access.</p>
    <input id="cf-link" name="file_link" type="url" inputmode="url" autocomplete="url" placeholder="https://" aria-describedby="cf-link-hint cf-link-error" />
    <p id="cf-link-error" class="field__error" hidden></p>
  </div>

  <div class="honeypot" aria-hidden="true">
    <label for="cf-gotcha">Leave this empty</label>
    <input id="cf-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="intent" value={intent} />
  <input type="hidden" name="_subject" value={subjectFor(id)} />

  <p class="mt-8">
    <button class="btn btn-primary" type="submit">Send message</button>
  </p>
</form>

<style>
  .contact-form {
    max-width: 36rem;
  }
  .field {
    margin-top: 1.5rem;
    border: 0;
    padding: 0;
  }
  .field label,
  .field legend {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .field__hint {
    margin: -0.15rem 0 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="url"],
  .field textarea {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-xs);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .field [aria-invalid="true"] {
    border-width: 2px;
    border-color: var(--color-text);
  }
  .field__error {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .field__error::before {
    content: "Check this: ";
    font-weight: 400;
  }
  .choices {
    display: grid;
    gap: 0.25rem;
  }
  .field .choice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 400;
    margin: 0;
    cursor: pointer;
  }
  .choice input {
    width: 1.15rem;
    height: 1.15rem;
  }
  .form-summary {
    padding: 0.9rem 1rem;
    border: 2px solid var(--color-text);
    background: var(--color-panel);
    font-weight: 600;
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  type Errors = Record<string, string>;

  const form = document.querySelector<HTMLFormElement>(".contact-form");
  if (form) {
    const errors: Errors = JSON.parse(form.dataset.errors ?? "{}");
    const subjects: Record<string, string> = JSON.parse(form.dataset.subjects ?? "{}");
    const summary = form.querySelector<HTMLElement>(".form-summary")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const subject = form.querySelector<HTMLInputElement>('input[name="_subject"]')!;
    const buttonLabel = button.textContent;
    form.noValidate = true;

    // Links from other worlds arrive as ?world=writing and so on.
    const preset = new URLSearchParams(location.search).get("world");
    const presetInput = form.querySelector<HTMLInputElement>(`input[type="radio"][name="world"][value="${CSS.escape(preset ?? "")}"]`);
    if (presetInput) presetInput.checked = true;

    const syncSubject = () => {
      const chosen = form.querySelector<HTMLInputElement>('input[name="world"]:checked, input[type="hidden"][name="world"]');
      if (chosen && subjects[chosen.value]) subject.value = subjects[chosen.value];
    };
    form.addEventListener("change", syncSubject);
    syncSubject();

    const setError = (id: string, control: HTMLElement | null, message: string | null) => {
      const el = form.querySelector<HTMLElement>(`#${id}-error`);
      if (!el) return;
      el.textContent = message ?? "";
      el.hidden = !message;
      control?.setAttribute("aria-invalid", message ? "true" : "false");
    };

    const validate = () => {
      const name = form.elements.namedItem("name") as HTMLInputElement;
      const email = form.elements.namedItem("email") as HTMLInputElement;
      const message = form.elements.namedItem("message") as HTMLTextAreaElement;
      const link = form.elements.namedItem("file_link") as HTMLInputElement;
      const radios = form.querySelectorAll<HTMLInputElement>('input[type="radio"][name="world"]');
      const chosen = form.querySelector<HTMLInputElement>('input[name="world"]:checked');

      const checks: [string, HTMLElement | null, string | null][] = [
        ["cf-name", name, name.value.trim() ? null : errors.name],
        ["cf-email", email, !email.value.trim() ? errors.email : email.validity.typeMismatch ? errors.emailFormat : null],
        ["cf-world", radios[0] ?? null, radios.length && !chosen ? errors.world : null],
        ["cf-message", message, message.value.trim() ? null : errors.message],
        ["cf-link", link, link.value.trim() && !/^https?:\/\/\S+\.\S+/.test(link.value.trim()) ? errors.link : null],
      ];
      checks.forEach(([id, control, msg]) => setError(id, control, msg));
      const firstBad = checks.find(([, , msg]) => msg);
      return firstBad ? (firstBad[1] as HTMLElement) : null;
    };

    const showSummary = (message: string | null) => {
      summary.textContent = message ?? "";
      summary.hidden = !message;
      if (message) summary.focus();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const firstBad = validate();
      if (firstBad) {
        showSummary(errors.summary);
        firstBad.focus();
        return;
      }
      if (form.dataset.connected !== "true") {
        showSummary(errors.notConnected);
        return;
      }

      button.disabled = true;
      button.textContent = "Sending…";
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(String(response.status));
        location.assign("/contact/thanks");
      } catch {
        showSummary(errors.network);
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    });
  }
</script>
