---
// The top of an inner page. Since the revamp (DESIGN.md 20.2) it is the dark PageHero band on every
// world; this wrapper keeps the older title/intro names working, with anything slotted after the
// intro placed inside the band.
import PageHero from "./PageHero.astro";

interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}
const { title, intro, eyebrow } = Astro.props;
---

{Astro.slots.has("default") ? (
  <PageHero title={title} lead={intro} eyebrow={eyebrow}><slot /></PageHero>
) : (
  <PageHero title={title} lead={intro} eyebrow={eyebrow} />
)}
