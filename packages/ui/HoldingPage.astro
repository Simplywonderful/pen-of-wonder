---
// The one-page site a world shows while its status is "soon", in the revamp's anatomy (brief 4.2):
// the dark page hero, what's coming beside the world's photograph, then WhatsApp beside a "notify
// me" form, and the latest posts once the blog is on. Copy lives in packages/config/worlds.ts.
// Dev's "what's coming" section sits on faint graph paper: it is honest about being unbuilt.
import { world as getWorld, worldUrl, type WorldId } from "@pow/config/worlds";
import type { ImageMetadata } from "astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import HeroFigure from "./HeroFigure.astro";
import PageHero from "./PageHero.astro";
import Eyebrow from "./Eyebrow.astro";
import ContactForm from "./ContactForm.astro";

interface Props {
  world: WorldId;
  /** The world's approved photograph of its work, if it has one. */
  image?: { src: ImageMetadata; alt: string };
  /** The latest posts, once the world's blog is switched on (packages/ui/blog.ts, blogIsOn). */
  posts?: { title: string; href: string; date: string }[];
}
const { world: id, image, posts = [] } = Astro.props;
const w = getWorld(id);
const h = w.holding;
if (!h) throw new Error(`${id} has no holding copy in worlds.ts`);
---

<PageHero eyebrow={`${w.name} · opening soon`} title={h.headline} lead={h.line}>
  <WhatsAppButton world={id} service={h.ask} label={h.button} variant="primary" event="whatsapp_hero" />
</PageHero>

<section class:list={["section coming", id === "dev" && "coming--graph"]} aria-labelledby="coming-heading">
  {
    id === "dev" && (
      <svg class="coming__grid" aria-hidden="true" focusable="false">
        <defs>
          <pattern id="graph" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#graph)" />
      </svg>
    )
  }
  <div class:list={["wrap coming__inner", image && "coming__inner--image"]}>
    <div>
      <Eyebrow>Opening soon</Eyebrow>
      <h2 id="coming-heading" class="coming__heading">What's coming</h2>
      <ul class="coming__list">
        {h.services.map((s) => <li>{s}</li>)}
      </ul>
      {
        h.aside && (
          <p class="coming__aside">
            {h.aside.text} <a href={worldUrl(h.aside.world)}>{h.aside.label}</a>.
          </p>
        )
      }
    </div>
    {image && <HeroFigure src={image.src} alt={image.alt} />}
  </div>
</section>

<section class="section section--panel" aria-labelledby="notify-heading">
  <div class="wrap notify">
    <div>
      <h2 id="notify-heading" class="notify__heading">Hear when we open</h2>
      <p class="mt-4 max-w-[48ch]">Leave your email and we'll write once, when {w.name} opens. Or ask us now on WhatsApp.</p>
      <p class="mt-6"><WhatsAppButton world={id} service={h.ask} label={h.button} variant="primary" /></p>
    </div>
    <div class="notify__form">
      <ContactForm world={id} askWorld={false} intent="notify" />
    </div>
  </div>
</section>

{
  posts.length > 0 && (
    <section class="section" aria-labelledby="holding-blog">
      <div class="wrap">
        <h2 id="holding-blog" class="coming__heading">From the blog</h2>
        <ul class="coming__list">
          {posts.map((p) => (
            <li>
              <a href={p.href}>{p.title}</a>
              <span class="coming__date">{p.date}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4"><a href="/blog">All posts</a></p>
      </div>
    </section>
  )
}

<style>
  .coming--graph {
    position: relative;
    overflow: hidden;
  }
  .coming__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-rule);
  }
  .coming--graph .coming__inner {
    position: relative;
  }
  .coming__inner {
    display: grid;
    gap: 2.5rem;
  }
  .coming__heading {
    margin-top: 1rem;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
  }
  .coming__list {
    list-style: none;
    padding: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    max-width: 40rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .coming__list li {
    padding-block: 0.85rem;
  }
  .coming__list li + li {
    border-top: 1px solid var(--color-rule);
  }
  .coming__date {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .coming__aside {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }
  .coming__inner :global(.hero-figure img) {
    border-radius: var(--radius);
    border-color: var(--color-rule);
  }
  .notify {
    display: grid;
    gap: 2.5rem;
  }
  .notify__heading {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
  }
  .notify__form {
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  @media (min-width: 64rem) {
    .coming__inner--image {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 4rem;
    }
    .notify {
      grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>
