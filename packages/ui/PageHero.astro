---
// The top of every inner page (DESIGN.md 20.2): a dark band with an eyebrow, the H1, a lead and
// whatever is slotted after it (buttons, a short note). Ink Green by day, deep ink at night, on
// every world. Slotted text, links and primary buttons are restyled to read on the band.
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="page-hero">
  <div class="wrap page-hero__inner">
    {eyebrow && <Eyebrow tone="band">{eyebrow}</Eyebrow>}
    <h1 class:list={["page-hero__title", eyebrow && "page-hero__title--after"]}>{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    {Astro.slots.has("default") && <div class="page-hero__extra"><slot /></div>}
  </div>
</header>

<style>
  .page-hero {
    background: var(--color-band);
    color: var(--color-band-ink);
  }
  .page-hero__inner {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .page-hero__title {
    max-width: 22ch;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
    color: inherit;
  }
  .page-hero__title--after {
    margin-top: 1rem;
  }
  .page-hero__lead {
    margin-top: 1.25rem;
    max-width: 60ch;
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    color: var(--color-band-muted);
  }
  .page-hero__extra {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .page-hero__extra :global(> p) {
    flex-basis: 100%;
  }
  .page-hero__extra :global(.text-muted) {
    color: var(--color-band-muted);
  }
  .page-hero__extra :global(a:not(.btn)) {
    text-decoration-color: var(--color-band-muted);
  }
  .page-hero__extra :global(a:not(.btn):hover) {
    text-decoration-color: var(--color-band-ink);
  }
  .page-hero__extra :global(.btn-primary) {
    background: var(--color-band-ink);
    color: var(--color-band);
  }
  .page-hero__extra :global(.btn-secondary) {
    border-color: var(--color-band-ink);
    color: var(--color-band-ink);
  }
  .page-hero__extra :global(.btn-secondary:hover) {
    background: var(--color-band-panel);
  }
  .page-hero :global(:focus-visible) {
    outline-color: var(--color-band-ink);
  }
</style>
