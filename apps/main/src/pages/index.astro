---
// Main's home in the revamp's anatomy (DESIGN.md 20.5), with the section order and words approved in
// section 6: hero, the worlds, proof, how we work, Hidden Treasures, the founder, testimonials, and
// the closing call to action.
import "../styles/global.css";
import Layout from "@pow/ui/Layout.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import ProofStrip from "@pow/ui/ProofStrip.astro";
import Testimonials from "@pow/ui/Testimonials.astro";
import PortraitMount from "@pow/ui/PortraitMount.astro";
import Todo from "@pow/ui/Todo.astro";
import HomeHero from "@pow/ui/HomeHero.astro";
import Eyebrow from "@pow/ui/Eyebrow.astro";
import CardGrid from "@pow/ui/CardGrid.astro";
import Card from "@pow/ui/Card.astro";
import Steps from "@pow/ui/Steps.astro";
import FeatureBand from "@pow/ui/FeatureBand.astro";
import SplitIntro from "@pow/ui/SplitIntro.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import { howWeWorkHeadings, howWeWorkWords } from "@pow/ui/how-we-work";
import { showTodos } from "@pow/ui/todos";
import { organisationLd } from "@pow/config/structured";
import { imprintName, titles } from "@pow/config/books";
import { proofEntry } from "@pow/config/proof";
import { whatsappLink } from "@pow/config/contact";
import { world as getWorld, worldUrl } from "@pow/config/worlds";
import { legal } from "@pow/config/legal";
import { home } from "../data/home";
import portrait from "../assets/portrait-arms.png";

const printed = proofEntry("publishing-readers");
const covers = titles.filter((t) => t.coverImage);
---

<Layout world="main" title={home.title} description={home.description} jsonLd={[organisationLd()]} note="Marketing, writing, research and publishing, from Ibadan" emblem>
  <HomeHero eyebrow={legal.company} title={home.h1} highlight="win." lead={home.lead} steps={howWeWorkWords} family>
    <Fragment slot="actions">
      <a class="btn btn-on-band" href="#worlds" data-event="cta_hero_worlds">{"Find your service"} <span class="arrow" aria-hidden="true">→</span></a>
      <WhatsAppButton world="main" variant="band-outline" event="whatsapp_hero" />
    </Fragment>
  </HomeHero>

  <section id="worlds" class="section section--panel scroll-mt-24" aria-labelledby="worlds-heading">
    <div class="wrap">
      <Eyebrow>Pen of Wonder</Eyebrow>
      <h2 id="worlds-heading" class="section-heading">{home.worldsHeading}</h2>
      <p class="section-intro">{home.worldsIntro}</p>
      <CardGrid columns={4} label={home.worldsHeading}>
        {
          home.dividers.map((d) => {
            const w = getWorld(d.world);
            const soon = w.status === "soon";
            return (
              <Card
                href={worldUrl(d.world)}
                title={w.label}
                text={d.who}
                items={d.services}
                link={soon ? "Opening soon: see what's coming" : `Go to ${w.label}`}
                icon={d.world}
                accent={d.world}
                event={`world_card_${d.world}`}
              />
            );
          })
        }
        <Card
          href={whatsappLink("dev", "joining the Dev waitlist")}
          title="Dev: coming soon"
          text={home.dev.line}
          link={home.dev.link}
          icon="dev"
          accent="dev"
          narrow
          event="world_card_dev"
        />
      </CardGrid>
    </div>
  </section>

  <div class="section proof-section">
    <div class="wrap">
      <ProofStrip ids={["marketing-cpl-summary", "research-manuscripts", "publishing-readers"]} heading={home.proofHeading} />
    </div>
  </div>

  <div id="how-we-work">
    <Steps id="how-heading" heading="How we work" steps={howWeWorkHeadings} ground="panel" />
  </div>

  <div id="hidden-treasures">
    <FeatureBand
      id="books-heading"
      eyebrow={imprintName()}
      heading={home.booksHeading}
      listLabel="The Companion Readers, by class"
      items={titles.map((t) => ({ label: t.level, detail: t.title }))}
    >
      <p>
        {imprintName()} is Wonderful Adebagbo's own imprint. He wrote the {titles.length === 6 ? "six" : titles.length} Companion Readers
        for Nigerian primary classes, from picture words in Basic 1 to a final-year story in Basic 6{printed.status === "live" ? ", and they were printed in 2026" : ""}.
        Our publishing services grew out of making them.
      </p>
      {showTodos && printed.status === "pending" && <p><Todo label={`TODO: "${printed.wording}" waits for ${printed.needs}`} /></p>}
      {showTodos && covers.length === 0 && <p><Todo label="FRONT COVERS: clean cover files for the six readers (intake Q5)" /></p>}
      <p class="feature-actions"><a class="btn btn-on-band" href={worldUrl("publishing")}>{home.booksButton} <span class="arrow" aria-hidden="true">→</span></a></p>
    </FeatureBand>
  </div>

  <div id="founder">
    <SplitIntro id="founder-heading" eyebrow={home.founderHeading} heading="Wonderful Adebagbo">
      <div slot="aside" class="founder__photo">
        <PortraitMount src={portrait} alt={home.portraitAlt} width={790} height={988} sizes="(min-width: 64rem) 18rem, (min-width: 40rem) 20rem, 80vw" />
      </div>
      {home.founder.map((p) => <p>{p}</p>)}
      <p class="font-semibold">{home.valuesIntro}</p>
      <dl class="values">
        {
          home.values.map((v) => (
            <div>
              <dt>{v.name}</dt>
              <dd>{v.text}</dd>
            </div>
          ))
        }
      </dl>
      <p><a class="btn btn-secondary" href="/about">More about us and our founder <span class="arrow" aria-hidden="true">→</span></a></p>
    </SplitIntro>
  </div>

  <div class="wrap">
    <Testimonials worlds={["marketing", "research"]} />
  </div>

  <CtaPanel id="final-heading" heading={home.finalHeading} text={home.final}>
    <WhatsAppButton world="main" variant="on-band" event="whatsapp_cta" />
    <a class="btn btn-band-outline" href="/contact">Send an email</a>
  </CtaPanel>
</Layout>

<style>
  .section-heading {
    margin-top: 1rem;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
  }
  .section-intro {
    margin-top: 1rem;
    max-width: 60ch;
    color: var(--color-muted);
  }
  .proof-section :global(.proof) {
    margin: 0;
  }
  .feature-actions {
    margin-top: 2rem;
  }
  .founder__photo {
    margin-top: 2rem;
    max-width: 18rem;
  }
  .values {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--color-panel);
  }
  .values dt {
    display: inline;
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-heading);
  }
  .values dd {
    display: inline;
    margin-left: 0.25rem;
  }
</style>
