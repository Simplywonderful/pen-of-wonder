---
import "../styles/global.css";
import { getCollection } from "astro:content";
import Layout from "@pow/ui/Layout.astro";
import { withContactEmail } from "@pow/ui/contact-email";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const html = withContactEmail(entry.rendered?.html ?? "");
const d = entry.data;
const updated = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "Africa/Lagos" }).format(d.updated);
---

<Layout world="main" title={d.metaTitle} description={d.description} note="Marketing, writing, research and publishing, from Ibadan">
  <article class="wrap pt-10 md:pt-16 lg:pt-20">
    <header>
      <h1 class="max-w-[22ch] text-3xl tracking-(--tracking-display)">{d.title}</h1>
      <p class="mt-4 text-sm text-muted">
        Last updated <time datetime={d.updated.toISOString().slice(0, 10)}>{updated}</time>
      </p>
    </header>
    <div class="prose mt-10">
      <Fragment set:html={html} />
    </div>
  </article>
</Layout>
