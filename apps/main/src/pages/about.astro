---
// About, in the revamp's anatomy (DESIGN.md 20.5): PageHero, then sections alternating page, panel
// and band grounds. Words unchanged from the approved page.
import "../styles/global.css";
import Layout from "@pow/ui/Layout.astro";
import PageHero from "@pow/ui/PageHero.astro";
import PortraitMount from "@pow/ui/PortraitMount.astro";
import SplitIntro from "@pow/ui/SplitIntro.astro";
import Steps from "@pow/ui/Steps.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import Eyebrow from "@pow/ui/Eyebrow.astro";
import { howWeWorkHeadings } from "@pow/ui/how-we-work";
import { legal } from "@pow/config/legal";
import { imprintName } from "@pow/config/books";
import { organisationLd } from "@pow/config/structured";
import { worldUrl } from "@pow/config/worlds";
import { home } from "../data/home";
import portrait from "../assets/portrait-arms.png";

// Founder facts are the ones research's About page already carries, approved by the owner.
// No postgraduate study and no CV percentages, on any world.
const founder = [
  "Wonderful Adebagbo founded Pen of Wonder in 2021. He studied biochemistry at McPherson University and graduated top of his class, department and faculty.",
  "Before and alongside Pen of Wonder he was lead research writer at NIFE Writing Consult (2022 to 2024), senior researcher at ADAC Data Consult (2022 to 2025), where he designed and led a six-month field study, and Head of Academy at Ileoja Academy (2025). He is a co-author of two peer-reviewed papers, the most recent published in AIMS Medical Science in 2025.",
  "He reads everything, a habit that started with the Bible when he was a quiet child, and he wrote the Hidden Treasures readers because he wants more children to have it.",
];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: legal.founder,
  jobTitle: "Founder",
  worksFor: { "@type": "Organization", name: "Pen of Wonder", legalName: legal.company },
  alumniOf: { "@type": "CollegeOrUniversity", name: "McPherson University" },
};
---

<Layout
  world="main"
  title="About us | Pen of Wonder"
  description="Pen of Wonder is a marketing, writing, research and publishing company in Ibadan, Nigeria, founded by Wonderful Adebagbo. Registered business name, CAC No. 7809965."
  jsonLd={[organisationLd(), personLd]}
  note="Marketing, writing, research and publishing, from Ibadan"
  emblem
>
  <PageHero
    eyebrow="About"
    title="About Pen of Wonder"
    lead="Pen of Wonder is a marketing, writing, research and publishing company based in Ibadan, Nigeria. We run ads, write the documents people use to get hired and funded, help researchers get their papers published, and make books for children. Each of those has its own site, and they share one way of working."
  />

  <SplitIntro id="lab-heading" eyebrow="How we think" heading="That way of working comes from a lab.">
    <p>
      We start with what the work is for, decide what would show it's working, test it, and tell you what we found, including when
      the answer isn't the one you wanted. We would rather say "this won't work yet" than take money for something that can't.
    </p>
    <p>We work remotely, so where you are matters less than what you need.</p>
  </SplitIntro>

  <SplitIntro id="founder-heading" eyebrow="Our founder" heading={legal.founder} ground="panel">
    <div slot="aside" class="founder__photo">
      <PortraitMount src={portrait} alt={home.portraitAlt} width={790} height={988} sizes="(min-width: 64rem) 18rem, (min-width: 40rem) 20rem, 80vw" />
    </div>
    {founder.map((p) => <p>{p}</p>)}
  </SplitIntro>

  <section class="section" aria-labelledby="values-heading">
    <div class="wrap">
      <Eyebrow>P-E-N</Eyebrow>
      <h2 id="values-heading" class="section-heading">What we stand on</h2>
      <dl class="values">
        {
          home.values.map((v) => (
            <div>
              <dt>{v.name.replace(".", "")}</dt>
              <dd>{v.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Steps id="how-heading" heading="How we work" steps={howWeWorkHeadings} ground="panel" />

  <section class="section" aria-labelledby="registration-heading">
    <div class="wrap">
      <h2 id="registration-heading" class="section-heading">Registration</h2>
      <div class="prose mt-6">
        <p>{legal.legalLine}</p>
        <p>
          {imprintName()}, the imprint behind our founder's children's readers, is the trading name of {legal.founder} personally.
          Pen of Wonder provides publishing services to it but is not its publisher.
        </p>
        <p>
          Our Academic Integrity Policy applies to everything we do: <a href={worldUrl("main", "/academic-integrity")}>read it here</a>.
        </p>
      </div>
    </div>
  </section>

  <CtaPanel id="talk-heading" heading="Talk to us" text="Message us on WhatsApp, or use the contact form. We reply within one working day.">
    <WhatsAppButton world="main" variant="on-band" />
    <a class="btn btn-band-outline" href="/contact">Send an email</a>
  </CtaPanel>
</Layout>

<style>
  .section-heading {
    margin-top: 1rem;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
  }
  .founder__photo {
    margin-top: 2rem;
    max-width: 18rem;
  }
  .values {
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem;
  }
  .values > div {
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
  }
  .values dt {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--color-heading);
  }
  .values dd {
    margin-top: 0.4rem;
  }
  @media (min-width: 64rem) {
    .values {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
