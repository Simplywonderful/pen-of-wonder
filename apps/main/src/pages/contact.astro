---
import "../styles/global.css";
import Layout from "@pow/ui/Layout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import ContactForm from "@pow/ui/ContactForm.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import Todo from "@pow/ui/Todo.astro";
import { contact, contactPlaceholders } from "@pow/config/contact";
---

<Layout
  world="main"
  title="Contact | Pen of Wonder"
  description="Message Pen of Wonder about marketing, writing, research or publishing. WhatsApp or email; we reply within one working day."
  note="Marketing, writing, research and publishing, from Ibadan"
>
  <PageHead title="Contact" intro={`Send a message here or on WhatsApp. Tell us which part of Pen of Wonder it's for, or pick Not sure yet. We reply ${contact.replyTime}.`} />

  <div class="wrap contact mt-12">
    <section aria-labelledby="form-heading">
      <h2 id="form-heading" class="text-2xl">Send a message</h2>
      <ContactForm world="main" />
    </section>
    <aside class="direct" aria-labelledby="direct-heading">
      <h2 id="direct-heading" class="font-serif text-lg">Or reach us directly</h2>
      <p class="mt-3"><WhatsAppButton world="main" label={`WhatsApp ${contact.whatsapp.display}`} /></p>
      <p class="mt-4">
        Email: {contact.email ? <a href={`mailto:${contact.email}`} class="break-all">{contact.email}</a> : <Todo label={contactPlaceholders.email} />}
      </p>
      <p class="mt-4 text-muted">Ibadan, Nigeria, WAT (UTC+1). We reply {contact.replyTime}.</p>
    </aside>
  </div>
</Layout>

<style>
  .contact {
    display: grid;
    gap: 3rem;
  }
  .direct {
    font-size: var(--text-sm);
  }
  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 40rem) minmax(12rem, 16rem);
      column-gap: 5rem;
      align-items: start;
    }
    .direct {
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-rule);
    }
  }
</style>
