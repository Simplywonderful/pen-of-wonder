---
// One page per service. Unconfirmed services are built only in development and review builds.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import Faq from "@pow/ui/Faq.astro";
import Todo from "@pow/ui/Todo.astro";
import { faqLd } from "@pow/ui/faq-ld";
import { showTodos } from "@pow/ui/todos";
import { worldOrigin } from "@pow/config/worlds";
import { liveServices, type Service } from "../data/services";

export function getStaticPaths() {
  return liveServices(showTodos).map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Service };
const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: s.name,
  description: s.description,
  provider: { "@type": "ProfessionalService", name: "Pen of Wonder Marketing", url: worldOrigin("marketing", "production") },
  areaServed: ["NG", "GB", "US"],
};
---

<MarketingLayout title={s.title} description={s.description} jsonLd={s.questions.length ? [serviceLd, faqLd(s.questions)] : [serviceLd]} noindex={!s.confirmed}>
  <PageHead title={s.name} intro={s.intro}>
    {!s.confirmed && <p class="mt-4"><Todo label="CONFIRM THIS SERVICE IS OFFERED: this page stays out of the menu and production until then" /></p>}
    <p class="mt-8"><WhatsAppButton world="marketing" service={s.ask} label={`Chat about ${s.ask}`} variant="primary" /></p>
  </PageHead>

  <section class="wrap mt-16" aria-labelledby="includes-heading">
    <h2 id="includes-heading" class="text-2xl">What's included</h2>
    <dl class="includes">
      {
        s.includes.map((i) => (
          <div>
            <dt>{i.name}</dt>
            <dd>{i.detail}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    s.notes.map((n, i) => (
      <section class="wrap mt-12" aria-labelledby={`note-${i}`}>
        <h2 id={`note-${i}`} class="text-xl">
          {n.heading}
        </h2>
        <p class="mt-3 max-w-[60ch]">{n.body}</p>
      </section>
    ))
  }

  <section class="wrap mt-12" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-xl">How it runs</h2>
    <p class="mt-3 max-w-[60ch]">
      Every job follows the same test log: diagnose, hypothesise, build, test, then scale and report. <a href="/process">See the process</a>.
    </p>
  </section>

  {
    s.questions.length > 0 && (
      <div class="wrap mt-12">
        <Faq items={s.questions} />
      </div>
    )
  }

  <section class="wrap mt-16" aria-labelledby="next-heading">
    <div class="next">
      <h2 id="next-heading" class="text-2xl">Talk it through first</h2>
      <p class="mt-3 max-w-[60ch]">Tell us what you're selling and what you've tried. The first conversation is free, and we'll say plainly whether this is the right service for you.</p>
      <p class="mt-6"><WhatsAppButton world="marketing" service={s.ask} label={`Chat about ${s.ask}`} variant="primary" /></p>
    </div>
  </section>
</MarketingLayout>

<style>
  .includes {
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
  .includes > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .includes dt {
    font-weight: 600;
    color: var(--color-heading);
  }
  .includes dd {
    max-width: 60ch;
  }
  .next {
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule-strong);
  }
  @media (min-width: 64rem) {
    .includes > div {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 2rem;
    }
  }
</style>
