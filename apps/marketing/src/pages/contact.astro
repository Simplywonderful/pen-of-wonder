---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import ContactForm from "@pow/ui/ContactForm.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import Todo from "@pow/ui/Todo.astro";
import { contact, contactPlaceholders } from "@pow/config/contact";
---

<MarketingLayout title="Contact | Pen of Wonder Marketing" description="Tell us about your offer and your goal. WhatsApp or email; we reply within one working day.">
  <PageHead title="Contact" intro={`WhatsApp is quickest. Or send a message here, with what you sell and what you've tried. We reply ${contact.replyTime}.`} />

  <div class="wrap contact mt-12">
    <section aria-labelledby="form-heading">
      <h2 id="form-heading" class="text-2xl">Send a message</h2>
      <ContactForm world="marketing" askWorld={false} />
    </section>
    <aside class="direct" aria-labelledby="direct-heading">
      <h2 id="direct-heading" class="font-serif text-lg">Or reach us directly</h2>
      <p class="mt-3"><WhatsAppButton world="marketing" service="paid ads" label={`WhatsApp ${contact.whatsapp.display}`} /></p>
      <p class="mt-4">
        Email: {contact.email ? <a href={`mailto:${contact.email}`} class="break-all">{contact.email}</a> : <Todo label={contactPlaceholders.email} />}
      </p>
    </aside>
  </div>
</MarketingLayout>

<style>
  .contact {
    display: grid;
    gap: 3rem;
  }
  .direct {
    font-size: var(--text-sm);
  }
  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 40rem) minmax(12rem, 16rem);
      column-gap: 5rem;
      align-items: start;
    }
    .direct {
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-rule);
    }
  }
</style>
