---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import ContactSection from "@pow/ui/ContactSection.astro";
import { contact } from "@pow/config/contact";
---

<MarketingLayout title="Contact | Pen of Wonder Marketing" description="Tell us about your offer and your goal. WhatsApp or email; we reply within one working day.">
  <PageHead eyebrow="Contact" title="Contact" intro={`WhatsApp is quickest. Or send a message here, with what you sell and what you've tried. We reply ${contact.replyTime}.`} />
  <ContactSection world="marketing" service="paid ads" />
</MarketingLayout>
