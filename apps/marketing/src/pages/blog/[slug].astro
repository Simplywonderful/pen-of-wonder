---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import BlogArticle from "@pow/ui/BlogArticle.astro";
import { getPosts, postDescription, postLd, postTitle, type Post } from "@pow/ui/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<MarketingLayout title={postTitle("marketing", post)} description={postDescription(post)} ogType="article" noindex={post.data.draft} jsonLd={postLd("marketing", post)}>
  <BlogArticle world="marketing" post={post} />
</MarketingLayout>
