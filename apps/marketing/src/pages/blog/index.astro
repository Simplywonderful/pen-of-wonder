---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import BlogIndex from "@pow/ui/BlogIndex.astro";
import { blogs } from "@pow/config/blogs";
import { getPosts } from "@pow/ui/blog";

const posts = await getPosts();
---

<MarketingLayout title={blogs.marketing.metaTitle} description={blogs.marketing.metaDescription}>
  <BlogIndex world="marketing" posts={posts} />
</MarketingLayout>
