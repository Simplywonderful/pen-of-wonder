---
// Marketing's home in the revamp's anatomy (DESIGN.md 20.5), with the copy approved on 26 Oct 2026
// (PHASE-0.md section 5). Numbers come from the proof register and stay off production pages until
// their evidence is on file.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import ProofStrip from "@pow/ui/ProofStrip.astro";
import Testimonials from "@pow/ui/Testimonials.astro";
import Faq from "@pow/ui/Faq.astro";
import HomeHero from "@pow/ui/HomeHero.astro";
import SplitIntro from "@pow/ui/SplitIntro.astro";
import Eyebrow from "@pow/ui/Eyebrow.astro";
import CardGrid from "@pow/ui/CardGrid.astro";
import Card from "@pow/ui/Card.astro";
import Steps from "@pow/ui/Steps.astro";
import FeatureBand from "@pow/ui/FeatureBand.astro";
import LatestPosts from "@pow/ui/LatestPosts.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import type { IconName } from "@pow/ui/Icon.astro";
import { faqLd } from "@pow/ui/faq-ld";
import { showTodos } from "@pow/ui/todos";
import { worldServiceLd } from "@pow/config/structured";
import { getLivePosts } from "@pow/ui/blog";
import { liveServices, adSpendLine } from "../data/services";
import { steps } from "../data/process";
import { questions } from "../data/faq";
import heroDesk from "../assets/hero-desk.jpg";

const services = liveServices(showTodos);
const posts = (await getLivePosts()).slice(0, 3);
const homeQuestions = questions.filter((q) => q.home);
---

<MarketingLayout
  title="Pen of Wonder Marketing: paid ads run like experiments"
  description="Paid ads on Meta, LinkedIn, TikTok and X, with ad creative, landing pages and copy, for coaches, course creators and online businesses. Tracked, tested, reported plainly."
  jsonLd={[worldServiceLd("marketing", services.map((s) => s.name)), faqLd(homeQuestions)]}
>
  <HomeHero
    eyebrow="Words that sell"
    title="Profitable ads, run like experiments."
    highlight="run like experiments."
    lead="We plan, build and run paid ads on Meta, LinkedIn, TikTok and X for coaches, course creators and online businesses, and we show you which naira brought which lead."
    steps={steps.map((s) => s.name)}
    image={{ src: heroDesk, alt: "A printed sheet with two advert layouts side by side, one circled in pink ink, beside a phone showing a simple bar chart." }}
  >
    <Fragment slot="actions">
      <WhatsAppButton world="marketing" service="paid ads" label="Chat about your ads" variant="on-band" event="whatsapp_hero" />
      <a class="btn btn-band-outline" href="/work/northern-star">Read the Northern Star case</a>
    </Fragment>
  </HomeHero>

  <SplitIntro id="problem-heading" eyebrow="The problem" heading="Most ad budgets are spent on guesses.">
    <p>
      Boosted posts, audiences picked by feel, one creative nobody tested, and a dashboard nobody can read. Money goes out, a few
      leads come in, and no one can say which part worked, so nothing can be scaled.
    </p>
    <p>
      Our founder trained in a lab, and we run ads the same way: a clear hypothesis, a controlled test, honest measurement, and a
      budget that follows the evidence.
    </p>
  </SplitIntro>

  <section class="section section--panel" aria-labelledby="services-heading">
    <div class="wrap">
      <Eyebrow>Services</Eyebrow>
      <h2 id="services-heading" class="section-heading">What we do</h2>
      <CardGrid label="What we do">
        {services.map((s) => <Card href={`/${s.slug}`} title={s.name} text={s.summary} link="See what's included" icon={s.slug as IconName} event="service_card" />)}
      </CardGrid>
    </div>
  </section>

  <div class="section">
    <div class="wrap">
      <ProofStrip
        ids={["marketing-campaigns", "marketing-cpl", "marketing-roas", "marketing-spend"]}
        heading="The readings so far"
        layout="figures"
        label="Across 12+ client campaigns since [FIRST CAMPAIGN YEAR]. Ask us for the breakdown behind any figure."
      />
      <p class="spend">{adSpendLine}</p>
    </div>
  </div>

  <Steps id="log-heading" eyebrow="Process" heading="How a campaign runs" steps={steps.map((s) => ({ title: s.name, body: s.line }))} ground="panel">
    <p class="mt-8"><a href="/process">The whole process, step by step</a></p>
  </Steps>

  <FeatureBand
    id="case-heading"
    eyebrow="Featured case"
    heading="Northern Star Business Consult"
    listLabel="What we changed"
    items={[
      { label: "Account", detail: "Rebuilt the account" },
      { label: "Audiences", detail: "Narrowed to high-intent audiences on Meta and LinkedIn" },
      { label: "Creative", detail: "Wrote and tested new angles" },
      { label: "Tracking", detail: "Installed proper conversion tracking" },
    ]}
  >
    <p>Business consulting · Meta and LinkedIn</p>
    <p>
      A business consultancy was boosting posts with no tracking in place. We rebuilt the account, narrowed it to high-intent
      audiences on Meta and LinkedIn, wrote and tested new angles, and installed proper conversion tracking, so every lead could be
      traced to the campaign that brought it.
    </p>
    <p class="feature-actions"><a class="btn btn-on-band" href="/work/northern-star">Read the Northern Star case <span class="arrow" aria-hidden="true">→</span></a></p>
  </FeatureBand>

  <div class="wrap">
    <Testimonials worlds={["marketing"]} />
  </div>

  <LatestPosts posts={posts} />

  <section class="section section--panel" aria-label="Questions">
    <div class="wrap">
      <Faq items={homeQuestions} />
      <p class="mt-6"><a href="/faq">More questions</a></p>
    </div>
  </section>

  <CtaPanel
    id="final-heading"
    heading="Make your ad spend accountable."
    text="Tell us about your offer and your goal. If ads are the right move, we'll show you how we'd test it. If they aren't yet, we'll say so."
  >
    <WhatsAppButton world="marketing" service="paid ads" label="Chat about your ads" variant="on-band" />
    <a class="btn btn-band-outline" href="/contact">Send a message</a>
  </CtaPanel>
</MarketingLayout>

<style>
  .section-heading {
    margin-top: 1rem;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
  }
  .spend {
    margin-top: 2rem;
    max-width: 60ch;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--color-panel);
    border: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .feature-actions {
    margin-top: 2rem;
  }
</style>
