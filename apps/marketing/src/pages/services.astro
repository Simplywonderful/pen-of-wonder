---
// Services, in the revamp's anatomy (DESIGN.md 20.5): PageHero, a jump index, one section per
// service, the ad-spend line, the shared steps and a closing panel.
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import ServiceSections from "@pow/ui/ServiceSections.astro";
import Steps from "@pow/ui/Steps.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import { howWeWorkHeadings } from "@pow/ui/how-we-work";
import { showTodos } from "@pow/ui/todos";
import { worldServiceLd } from "@pow/config/structured";
import { liveServices, adSpendLine } from "../data/services";

const services = liveServices(showTodos);
---

<MarketingLayout
  title="Services | Pen of Wonder Marketing"
  description="Paid ads, ad creative, landing pages, copywriting, and content writing and SEO, run with a researcher's discipline."
  jsonLd={[worldServiceLd("marketing", services.map((s) => s.name))]}
>
  <PageHead
    eyebrow="Services"
    title="Everything your ads need, and nothing they don't."
    intro="Each service can be bought on its own or as part of a campaign. All of them are quoted after a free consultation."
  />

  <ServiceSections services={services} />

  {showTodos && <p class="wrap mt-6 text-sm text-muted">Development view: unconfirmed services show here; production builds leave them out.</p>}

  <Steps id="how-heading" eyebrow="How to work with us" heading="How we work" steps={howWeWorkHeadings} ground={services.length % 2 === 1 ? "panel" : "page"}>
    <p class="spend">{adSpendLine}</p>
  </Steps>

  <CtaPanel id="next-heading" heading="Not sure which service fits?" text="Tell us what you sell and what you've tried, and we'll say which service would help first.">
    <WhatsAppButton world="marketing" service="your services" label="Ask which service fits" variant="on-band" />
  </CtaPanel>
</MarketingLayout>

<style>
  .spend {
    margin-top: 2.5rem;
    max-width: 60ch;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
