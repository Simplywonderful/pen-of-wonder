---
import WritingLayout from "../../layouts/WritingLayout.astro";
import BlogArticle from "@pow/ui/BlogArticle.astro";
import { getPosts, postDescription, postLd, postTitle, type Post } from "@pow/ui/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<WritingLayout title={postTitle("writing", post)} description={postDescription(post)} ogType="article" noindex={post.data.draft} jsonLd={postLd("writing", post)}>
  <BlogArticle world="writing" post={post} />
</WritingLayout>
