---
// Services, in the revamp's anatomy (DESIGN.md 20.5): PageHero with the boundary sentence, a jump
// index, one section per service, the shared steps and a closing panel.
import WritingLayout from "../layouts/WritingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import ServiceSections from "@pow/ui/ServiceSections.astro";
import Steps from "@pow/ui/Steps.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import { howWeWorkHeadings } from "@pow/ui/how-we-work";
import { worldServiceLd } from "@pow/config/structured";
import { worldUrl } from "@pow/config/worlds";
import { services, quoteLine } from "../data/services";
import { boundary } from "../data/faq";

const [boundaryFirst] = boundary.split("Research team");
---

<WritingLayout
  title="Writing Services | Pen of Wonder Writing"
  description="CVs and cover letters, LinkedIn profiles, grant writing, business plans and proposals, ghostwriting, and editing and proofreading. Each quoted on request."
  jsonLd={[worldServiceLd("writing", services.map((s) => s.name))]}
>
  <PageHead eyebrow="Services" title="The documents we write, and the ones we don't." intro={quoteLine}>
    <p class="text-muted">{boundaryFirst}<a href={worldUrl("research")}>Research team</a>.</p>
  </PageHead>

  <ServiceSections services={services} />

  <Steps id="how-heading" eyebrow="How to work with us" heading="How we work" steps={howWeWorkHeadings} ground={services.length % 2 === 1 ? "panel" : "page"} />

  <CtaPanel id="next-heading" heading="Ask for a quote" text="Tell us what you have, who will read it and when it's due. We'll reply with a price and a date, or tell you honestly if we're not the right fit.">
    <WhatsAppButton world="writing" service="a writing job" label="Ask for a quote on WhatsApp" variant="on-band" />
    <a class="btn btn-band-outline" href="/contact">Request a quote by email</a>
  </CtaPanel>
</WritingLayout>
