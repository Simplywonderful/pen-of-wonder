---
// One page per writing service, with Service and FAQPage data and links to the guides that go with it.
import WritingLayout from "../layouts/WritingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import Faq from "@pow/ui/Faq.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import { faqLd } from "@pow/ui/faq-ld";
import { getPosts } from "@pow/ui/blog";
import { worldOrigin } from "@pow/config/worlds";
import { services, quoteLine, type Service } from "../data/services";

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Service };
const built = await getPosts();
const guides = s.guides.map((id) => built.find((p) => p.id === id)).filter((p) => p !== undefined);
const origin = worldOrigin("writing", "production");
const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: s.name,
  description: s.description,
  url: `${origin}/${s.slug}`,
  provider: { "@type": "ProfessionalService", name: "Pen of Wonder Writing", url: origin },
  areaServed: ["NG", "GB", "US"],
};
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Pen of Wonder Writing", item: origin },
    { "@type": "ListItem", position: 2, name: "Services", item: `${origin}/services` },
    { "@type": "ListItem", position: 3, name: s.name, item: `${origin}/${s.slug}` },
  ],
};
---

<WritingLayout title={s.title} description={s.description} jsonLd={[serviceLd, crumbs, faqLd(s.questions)]}>
  <PageHead eyebrow="Service" title={s.name} intro={s.intro}>
    <p class="text-muted">For {s.who.charAt(0).toLowerCase() + s.who.slice(1)}</p>
    <WhatsAppButton world="writing" service={s.ask} label={`Ask about ${s.ask} on WhatsApp`} variant="primary" />
  </PageHead>

  <section class="section" aria-labelledby="includes-heading"><div class="wrap">
    <h2 id="includes-heading" class="section-heading">What you get</h2>
    <dl class="includes">
      {
        s.includes.map((i) => (
          <div>
            <dt>{i.name}</dt>
            <dd>{i.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div></section>

  <section class="section section--panel" aria-label="Working together"><div class="wrap notes">
  <div aria-labelledby="needs-heading">
    <h2 id="needs-heading" class="text-xl">What we need from you</h2>
    <ul class="needs">
      {s.needs.map((n) => <li>{n}</li>)}
    </ul>
  </div>

  {
    s.notes.map((n, i) => (
      <div aria-labelledby={`note-${i}`}>
        <h2 id={`note-${i}`} class="text-xl">
          {n.heading}
        </h2>
        <p class="mt-3 max-w-[60ch]">{n.body}</p>
      </div>
    ))
  }

  <div aria-labelledby="price-heading">
    <h2 id="price-heading" class="text-xl">Price and timing</h2>
    <p class="mt-3 max-w-[60ch]">{quoteLine} The quote sets out what's included and the date you'll have it. <a href="/process">How a job runs</a>.</p>
  </div>
  </div></section>

  <section class="section" aria-label="Questions"><div class="wrap">
    <Faq items={s.questions} />

  {
    guides.length > 0 && (
      <div class="mt-12" aria-labelledby="guides-heading">
        <h2 id="guides-heading" class="text-xl">Free guides</h2>
        <ul class="needs">
          {guides.map((p) => (
            <li>
              <a href={`/blog/${p.id}`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  </div></section>

  <CtaPanel id="next-heading" heading="Ask for a quote" text="Tell us what you have, who will read it and when it's due. We'll reply with a price and a date, or tell you honestly if we're not the right fit.">
    <WhatsAppButton world="writing" service={s.ask} label={`Ask about ${s.ask} on WhatsApp`} variant="on-band" />
    <a class="btn btn-band-outline" href={`/contact?service=${encodeURIComponent(s.name)}`}>Request a quote by email</a>
  </CtaPanel>
</WritingLayout>

<style>
  .section-heading {
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
  }
  .notes {
    display: grid;
    gap: 2.5rem;
  }
  .notes :global(h2) {
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
  }
  @media (min-width: 64rem) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 4rem;
    }
  }
  .includes {
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
  .includes > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .includes dt {
    font-weight: 600;
    color: var(--color-heading);
  }
  .includes dd {
    max-width: 60ch;
  }
  .needs {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
    max-width: 60ch;
  }
  .needs li + li {
    margin-top: 0.4rem;
  }
  .next {
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule-strong);
  }
  @media (min-width: 64rem) {
    .includes > div {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 2rem;
    }
  }
</style>
