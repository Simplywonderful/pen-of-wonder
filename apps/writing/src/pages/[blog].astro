---
// The post list at /blog, built once the blog has a live post (blogIsOn).
import WritingLayout from "../layouts/WritingLayout.astro";
import BlogIndex from "@pow/ui/BlogIndex.astro";
import { blogs } from "@pow/config/blogs";
import { blogIsOn, getPosts } from "@pow/ui/blog";

export async function getStaticPaths() {
  return (await blogIsOn("writing")) ? [{ params: { blog: "blog" } }] : [];
}

const posts = await getPosts();
---

<WritingLayout title={blogs.writing.metaTitle} description={blogs.writing.metaDescription}>
  <BlogIndex world="writing" posts={posts} />
</WritingLayout>
