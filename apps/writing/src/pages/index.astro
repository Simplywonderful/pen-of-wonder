---
// Writing's home in the revamp's anatomy (DESIGN.md 20.5): the hero, the boundary sentence near the
// top (CLAUDE.md), the problem, the documents we write, how a job runs, the latest guides, questions
// and the quote request, closed like a letter (Writing's signature detail). No proof strip: writing
// has no register entry yet, and the brief says no filler.
import WritingLayout from "../layouts/WritingLayout.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import Faq from "@pow/ui/Faq.astro";
import HomeHero from "@pow/ui/HomeHero.astro";
import SplitIntro from "@pow/ui/SplitIntro.astro";
import Eyebrow from "@pow/ui/Eyebrow.astro";
import CardGrid from "@pow/ui/CardGrid.astro";
import Card from "@pow/ui/Card.astro";
import Steps from "@pow/ui/Steps.astro";
import LatestPosts from "@pow/ui/LatestPosts.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import type { IconName } from "@pow/ui/Icon.astro";
import { faqLd } from "@pow/ui/faq-ld";
import { worldServiceLd } from "@pow/config/structured";
import { worldUrl } from "@pow/config/worlds";
import { getLivePosts } from "@pow/ui/blog";
import { services } from "../data/services";
import { steps, stepWords } from "../data/process";
import { questions, boundary } from "../data/faq";
import heroDesk from "../assets/hero-desk.jpg";

const posts = (await getLivePosts()).slice(0, 3);
const homeQuestions = questions.filter((q) => q.home);
const [boundaryFirst] = boundary.split("Research team");
---

<WritingLayout
  title="Pen of Wonder Writing: CVs, grant proposals and business plans"
  description="CVs and cover letters, LinkedIn profiles, grant applications, business plans, ghostwriting and editing for job seekers, founders and NGOs. Quoted on request."
  jsonLd={[worldServiceLd("writing", services.map((s) => s.name)), faqLd(homeQuestions)]}
>
  <HomeHero
    eyebrow="Words that open doors"
    title="Documents that get read, and get you through the door."
    highlight="through the door."
    lead="CVs, LinkedIn profiles, grant applications and business plans for job seekers, founders and NGOs, written from your real evidence and aimed at the person who decides."
    steps={stepWords}
    image={{ src: heroDesk, alt: "A folded letter on cream paper and its envelope on an olive-green folder, with a fountain pen and a paper clip." }}
  >
    <Fragment slot="actions">
      <WhatsAppButton world="writing" service="a writing job" label="Ask for a quote on WhatsApp" variant="on-band" event="whatsapp_hero" />
      <a class="btn btn-band-outline" href="/services">See what we write</a>
    </Fragment>
  </HomeHero>

  <div class="wrap">
    <p class="boundary">
      {boundaryFirst}<a href={worldUrl("research")}>Research team</a>.
    </p>
  </div>

  <SplitIntro id="problem-heading" eyebrow="The problem" heading="Most documents are read for seconds before a decision.">
    <p>
      A recruiter skims a CV. A funder scores a proposal against a checklist. A lender turns to the numbers. Each one is looking for a
      reason to say yes, and most documents make them work too hard to find it.
    </p>
    <p>
      We start with what that reader needs to see, then find the evidence in your work that shows it, and write it so it can't be
      missed. Nothing is invented: every claim is one you can stand behind.
    </p>
  </SplitIntro>

  <section class="section section--panel" aria-labelledby="services-heading">
    <div class="wrap">
      <Eyebrow>Services</Eyebrow>
      <h2 id="services-heading" class="section-heading">What we write</h2>
      <CardGrid label="What we write">
        {services.map((s) => <Card href={`/${s.slug}`} title={s.name} text={s.summary} link="See what's included" icon={s.slug as IconName} event="service_card" />)}
      </CardGrid>
    </div>
  </section>

  <Steps id="steps-heading" eyebrow="How it works" heading="How a job runs" steps={steps.map((s) => ({ title: s.name, body: s.line }))}>
    <p class="mt-8"><a href="/process">How it works, in full</a></p>
  </Steps>

  <LatestPosts posts={posts} ground="panel" />

  <section class="section" aria-label="Questions">
    <div class="wrap">
      <Faq items={homeQuestions} />
      <p class="mt-6"><a href="/faq">More questions</a></p>
      <p class="aside">Need copy that sells? <a href={worldUrl("marketing")}>That's our Marketing team</a>.</p>
    </div>
  </section>

  <CtaPanel
    id="final-heading"
    heading="Tell us what you're sending, and to whom."
    text="Send the document you have, or a few lines about the one you need, and the date it's due. We'll reply with a quote, or tell you honestly if we're not the right fit."
  >
    <WhatsAppButton world="writing" service="a writing job" label="Ask for a quote on WhatsApp" variant="on-band" />
    <a class="btn btn-band-outline" href="/contact">Request a quote by email</a>
    <p slot="after" class="sign">
      <span>Yours sincerely,</span>
      <span class="sign__name">Pen of Wonder Writing</span>
    </p>
  </CtaPanel>
</WritingLayout>

<style>
  .boundary {
    margin-top: 2rem;
    max-width: 60ch;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-panel);
  }
  .section-heading {
    margin-top: 1rem;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
  }
  .aside {
    margin-top: 2rem;
    color: var(--color-muted);
  }
  /* Writing's signature detail: the closing panel ends like a letter, with a signature line. */
  .sign {
    margin-top: 2.5rem;
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-serif);
  }
  .sign__name {
    max-width: 16rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-band-rule);
    font-weight: 700;
  }
</style>
