---
import "../styles/global.css";
import Layout from "@pow/ui/Layout.astro";
import HoldingPage from "@pow/ui/HoldingPage.astro";
import { world } from "@pow/config/worlds";
import { worldServiceLd } from "@pow/config/structured";
import { blogIsOn, formatDate, getPosts } from "@pow/ui/blog";
import heroDesk from "../assets/hero-desk.jpg";

const w = world("writing");
const h = w.holding!;
const on = await blogIsOn("writing");
const posts = on
  ? (await getPosts()).slice(0, 3).map((p) => ({ title: p.data.title, href: `/blog/${p.id}`, date: formatDate(p.data.publishDate) }))
  : [];
---

<Layout world="writing" title={`${w.name}: opening soon`} description={`${h.headline} ${h.services.join(", ")}. Opening soon; message us on WhatsApp.`} jsonLd={[worldServiceLd("writing", h.services)]} note="Opening soon" localNav={on ? [{ href: "/blog", label: "Blog" }] : []} rss={on}>
  <HoldingPage world="writing" posts={posts} image={{ src: heroDesk, alt: "A folded letter on cream paper and its envelope on an olive-green folder, with a fountain pen and a paper clip." }} />
</Layout>
