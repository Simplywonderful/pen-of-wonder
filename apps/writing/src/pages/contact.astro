---
// "Request a quote": the shared details-beside-form section, preset to writing.
import WritingLayout from "../layouts/WritingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import ContactSection from "@pow/ui/ContactSection.astro";
import { contact } from "@pow/config/contact";
---

<WritingLayout title="Request a Quote | Pen of Wonder Writing" description="Ask for a quote for a CV, LinkedIn profile, grant application, business plan, ghostwriting or editing. We reply within one working day.">
  <PageHead
    eyebrow="Request a quote"
    title="Request a quote"
    intro={`Tell us which document you need, who will read it and when it's due. WhatsApp is quickest; this form reaches the same inbox. We reply ${contact.replyTime}.`}
  />
  <ContactSection world="writing" service="a writing job" formHeading="Send your request" intent="quote" />
</WritingLayout>
