---
// "Request a quote": the shared email form, preset to writing, beside WhatsApp and email.
import WritingLayout from "../layouts/WritingLayout.astro";
import PageHead from "@pow/ui/PageHead.astro";
import ContactForm from "@pow/ui/ContactForm.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import Todo from "@pow/ui/Todo.astro";
import { contact, contactPlaceholders } from "@pow/config/contact";
---

<WritingLayout title="Request a Quote | Pen of Wonder Writing" description="Ask for a quote for a CV, LinkedIn profile, grant application, business plan, ghostwriting or editing. We reply within one working day.">
  <PageHead
    title="Request a quote"
    intro={`Tell us which document you need, who will read it and when it's due. WhatsApp is quickest; this form reaches the same inbox. We reply ${contact.replyTime}.`}
  />

  <div class="wrap contact mt-12">
    <section aria-labelledby="form-heading">
      <h2 id="form-heading" class="text-2xl">Send your request</h2>
      <ContactForm world="writing" askWorld={false} />
    </section>
    <aside class="direct" aria-labelledby="direct-heading">
      <h2 id="direct-heading" class="font-serif text-lg">Or reach us directly</h2>
      <p class="mt-3"><WhatsAppButton world="writing" service="a writing job" label={`WhatsApp ${contact.whatsapp.display}`} /></p>
      <p class="mt-4">
        Email: {contact.email ? <a href={`mailto:${contact.email}`} class="break-all">{contact.email}</a> : <Todo label={contactPlaceholders.email} />}
      </p>
    </aside>
  </div>
</WritingLayout>

<style>
  .contact {
    display: grid;
    gap: 3rem;
  }
  .direct {
    font-size: var(--text-sm);
  }
  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 40rem) minmax(12rem, 16rem);
      column-gap: 5rem;
      align-items: start;
    }
    .direct {
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-rule);
    }
  }
</style>
