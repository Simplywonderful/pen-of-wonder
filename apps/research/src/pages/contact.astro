---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import ContactForm from "../components/ContactForm.astro";
import WhatsAppButton from "@pow/ui/WhatsAppButton.astro";
import RedPen from "../components/RedPen.astro";
import { contact as c } from "../data/pages/contact";
import Todo from "@pow/ui/Todo.astro";
import { placeholders, site } from "../data/site";
---

<BaseLayout title={c.title} description={c.description}>
  <PageHead title={c.h1} intro={c.intro}>
    <p class="mt-6 max-w-[60ch]">
      {c.reviewBefore}<RedPen mark="ring">{c.reviewRing}</RedPen>{c.reviewAfter}
    </p>
  </PageHead>

  <div class="sheet mt-12">
    <section aria-labelledby="form-heading">
      <h2 id="form-heading" class="text-2xl">{c.form.heading}</h2>
      <ContactForm />
    </section>
    <aside class="direct margin-note" aria-labelledby="direct-heading">
      <h2 id="direct-heading" class="font-serif text-lg text-text">{c.otherHeading}</h2>
      <p class="mt-3"><WhatsAppButton world="research" label={`WhatsApp ${site.whatsapp.display}`} /></p>
      <p class="mt-4">Email: {site.email ? <a href={`mailto:${site.email}`} class="break-all">{site.email}</a> : <Todo label={placeholders.email} />}</p>
      <p class="mt-4">
        {site.calendlyUrl ? (
          <>Book a tutoring session: <a href={site.calendlyUrl}>choose a time</a></>
        ) : (
          "To book a tutoring session, choose “Postgraduate student” in the form or message us on WhatsApp."
        )}
      </p>
      <p class="mt-4">We reply {site.replyTime}.</p>
    </aside>
  </div>
</BaseLayout>

<style>
  @media (min-width: 64rem) {
    .direct {
      grid-row: 1 / span 2;
    }
  }
</style>
