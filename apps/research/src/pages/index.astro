---
// Research's home in the family's revamp anatomy (root DESIGN.md 20, owner's decision 25 Nov 2026),
// with the approved words unchanged: the hero, where to start, the edit specimen (research's
// signature), the founder's published work, the free review as the closing panel, testimonials.
import BaseLayout from "../layouts/BaseLayout.astro";
import EditSpecimen from "../components/EditSpecimen.astro";
import ReferenceList from "../components/ReferenceList.astro";
import Testimonials from "../components/Testimonials.astro";
import HomeHero from "@pow/ui/HomeHero.astro";
import Eyebrow from "@pow/ui/Eyebrow.astro";
import CardGrid from "@pow/ui/CardGrid.astro";
import Card from "@pow/ui/Card.astro";
import SplitIntro from "@pow/ui/SplitIntro.astro";
import CtaPanel from "@pow/ui/CtaPanel.astro";
import type { IconName } from "@pow/ui/Icon.astro";
import { howWeWorkWords } from "@pow/ui/how-we-work";
import { home } from "../data/pages/home";
import { methodsSpecimen } from "../data/specimens";
import { organisationLd, personLd, worksLd } from "../data/structured";
import heroImage from "../assets/home-desk.webp";

const doorIcons: Record<string, IconName> = { "/publication-support": "research", "/work-with-us": "editing", "/coaching": "coaching" };
---

<BaseLayout title={home.title} description={home.description} jsonLd={[organisationLd, personLd, ...worksLd]}>
  <HomeHero
    eyebrow="Pen of Wonder Research"
    title={home.h1}
    highlight="through peer review."
    lead={home.intro}
    steps={howWeWorkWords}
    image={{ src: heroImage, alt: home.heroAlt }}
  >
    <Fragment slot="actions">
      <a class="btn btn-on-band" href="/contact?as=researcher" data-event="cta_hero_review">{home.primaryCta}</a>
    </Fragment>
  </HomeHero>

  <section class="section section--panel" aria-labelledby="doors-heading">
    <div class="wrap">
      <Eyebrow>Research</Eyebrow>
      <h2 id="doors-heading" class="section-heading">{home.doorsHeading}</h2>
      <CardGrid label={home.doorsHeading}>
        {home.doors.map((door) => <Card href={door.href} kicker={door.audience} title={door.title} text={door.text} link={door.link} icon={doorIcons[door.href] ?? "research"} event="service_card" />)}
      </CardGrid>
    </div>
  </section>

  <section class="sheet section" aria-labelledby="specimen-heading">
    <h2 id="specimen-heading" class="text-2xl">{home.specimenHeading}</h2>
    <aside class="margin-note">{home.specimenAside}</aside>
    <p class="mt-3 max-w-[60ch]">{home.specimenIntro}</p>
    <div class="wide">
      <EditSpecimen specimen={methodsSpecimen} />
    </div>
  </section>

  <SplitIntro id="published-heading" eyebrow="Our founder" heading={home.publishedHeading} ground="panel">
    <ReferenceList />
    <p class="published__background">{home.background}</p>
  </SplitIntro>

  <Testimonials />

  <CtaPanel id="review-heading" heading={home.reviewHeading} text={home.review}>
    <a class="btn btn-on-band" href="/contact?as=researcher">{home.primaryCta}</a>
    <p slot="after" class="cta-note">{home.sampleReview}</p>
  </CtaPanel>
</BaseLayout>

<style>
  .section-heading {
    margin-top: 1rem;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-display);
  }
  .published__background {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
  .cta-note {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-band-muted);
  }
</style>
