---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLivePosts, formatDate } from "../../lib/blog";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getLivePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.summary,
  datePublished: d.publishDate.toISOString(),
  author: d.author === site.owner ? { "@id": `${site.url}/about#person`, "@type": "Person", name: site.owner } : { "@type": "Person", name: d.author },
  publisher: { "@type": "Organization", name: site.name },
  mainEntityOfPage: `${site.url}/blog/${post.id}`,
};
---

<BaseLayout title={`${d.title} | ${site.name}`} description={d.summary} ogType="article" jsonLd={[articleLd]}>
  <article class="sheet pt-10 md:pt-16 lg:pt-20">
    <header>
      <p class="text-sm text-muted">
        By {d.author === site.owner ? <a href="/about#founder-heading">{d.author}, founder</a> : d.author}
        <span aria-hidden="true"> · </span>
        <time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)}</time>
      </p>
      <h1 class="mt-2 text-3xl tracking-(--tracking-display)">{d.title}</h1>
      <p class="mt-5 max-w-[60ch] text-lg text-muted">{d.summary}</p>
      <p class="mt-5 max-w-[60ch] border-t border-rule pt-4 text-sm text-muted">
        {d.series === "30 Lessons" && "Part of the series 30 Lessons I Learned as a Researcher. "}
        Adapted from posts first shared on LinkedIn between {formatDate(d.sourceDates.first)} and {formatDate(d.sourceDates.last)}.
      </p>
    </header>
    <div class="prose mt-10">
      <Content />
    </div>
    <footer class="mt-12 max-w-[65ch] border-t border-rule-strong pt-6">
      <p>
        {d.serviceLine} <a href={d.serviceLink}>{
          d.serviceLink === "/publication-support"
            ? "See how publication support works"
            : d.serviceLink === "/work-with-us"
              ? "Read our editing details"
              : "See coaching and tutoring"
        }</a>.
      </p>
      <p class="mt-6 text-sm"><a href="/blog">All pieces</a></p>
    </footer>
  </article>
</BaseLayout>
