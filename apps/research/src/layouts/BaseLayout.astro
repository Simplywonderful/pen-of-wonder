---
import "../styles/global.css";
import Header from "@pow/ui/Header.astro";
import Footer from "@pow/ui/Footer.astro";
import { nav, site } from "../data/site";
import { cleanPath } from "../lib/path";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: object[];
}

const { title, description, ogType = "website", noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(cleanPath(Astro.url.pathname), site.url).href;
const ogImage = new URL("/og.png", site.url).href;
const path = cleanPath(Astro.url.pathname);
---

<!doctype html>
<html lang="en-GB" data-world={site.world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#EDEEE7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1B2420" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pen of Wonder Research, set in ink green on parchment with the gold ink drop." />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Runs before paint so a stored theme never flashes the wrong one. */}
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add("js");
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header world={site.world} localNav={[...nav]} currentPath={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer world={site.world} businessLine={site.businessLine} emblem privacyHref="/privacy" termsHref="/terms" />
  </body>
</html>
