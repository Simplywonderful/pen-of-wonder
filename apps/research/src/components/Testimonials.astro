---
// Renders nothing until research's flag is on and approved quotes exist in packages/config/testimonials.ts.
// Research quotes need written permission and carry initials and role only.
import { approvedQuotes } from "@pow/config/testimonials";

const testimonials = approvedQuotes("research");
const show = testimonials.length > 0;
---

{
  show && (
    <section class="sheet mt-20" aria-labelledby="testimonials-heading">
      <h2 id="testimonials-heading" class="text-2xl">What researchers have said</h2>
      <div class="rule-list mt-6">
        {testimonials.map((t) => (
          <figure class="py-6">
            <blockquote class="max-w-[60ch] font-serif text-lg">“{t.quote}”</blockquote>
            <figcaption class="mt-2 text-sm text-muted">
              {t.by}, {t.role}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}
