---
// Research's contact form, with its "I am a" choice. It posts to pow-api's /submit once
// packages/config/api.ts switches the forms (revamp brief 5.2), otherwise to Formspree. The choice is
// sent as the service, so the alert says who is writing. Without JavaScript it is a normal POST:
// pow-api redirects to /contact/thanks, or back with ?sent=error. With JavaScript it validates in
// place, sends JSON with the time taken to fill it in, keeps what was typed if anything fails, and
// goes to /contact/thanks on success. _gotcha is the honeypot. The consent box must be ticked.
import Todo from "@pow/ui/Todo.astro";
import { api, formsUseApi } from "@pow/config/api";
import { worldUrl } from "@pow/config/worlds";
import { contact } from "../data/pages/contact";
import { roles, site, placeholders } from "../data/site";

const f = contact.form;
const useApi = formsUseApi();
const action = useApi ? `${api.origin}/submit` : `https://formspree.io/f/${site.formspreeId ?? "not-connected"}`;
const connected = useApi || Boolean(site.formspreeId);
---

<form
  class="contact-form"
  action={action}
  method="POST"
  data-connected={connected ? "true" : "false"}
  data-backend={useApi ? "api" : "formspree"}
  data-errors={JSON.stringify(f.errors)}
  data-sending={f.sending}
>
  {
    !connected && (
      <p class="mb-6 text-sm">
        <Todo label={placeholders.formspreeId} />
      </p>
    )
  }

  <div class="form-summary" role="alert" tabindex="-1" hidden></div>

  <div class="field">
    <label for="cf-name">{f.name}</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-error" />
    <p id="cf-name-error" class="field__error" hidden></p>
  </div>

  <div class="field">
    <label for="cf-email">{f.email}</label>
    <input
      id="cf-email"
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      aria-describedby="cf-email-error"
    />
    <p id="cf-email-error" class="field__error" hidden></p>
  </div>

  <fieldset class="field" aria-describedby="cf-role-error">
    <legend>{f.role}</legend>
    <div class="choices">
      {
        roles.map((r, i) => (
          <label class="choice">
            <input type="radio" name="service" value={r.value} required={i === 0} />
            <span>{r.label}</span>
          </label>
        ))
      }
    </div>
    <p id="cf-role-error" class="field__error" hidden></p>
  </fieldset>

  <div class="field">
    <label for="cf-message">{f.message}</label>
    <p id="cf-message-hint" class="field__hint">{f.messageHint}</p>
    <textarea id="cf-message" name="message" rows="6" required aria-describedby="cf-message-hint cf-message-error"
    ></textarea>
    <p id="cf-message-error" class="field__error" hidden></p>
  </div>

  <div class="field">
    <label for="cf-link">{f.link}</label>
    <p id="cf-link-hint" class="field__hint">{f.linkHint}</p>
    <input
      id="cf-link"
      name="file_link"
      type="url"
      inputmode="url"
      autocomplete="url"
      placeholder="https://"
      aria-describedby="cf-link-hint cf-link-error"
    />
    <p id="cf-link-error" class="field__error" hidden></p>
  </div>

  <div class="honeypot" aria-hidden="true">
    <label for="cf-gotcha">Leave this empty</label>
    <input id="cf-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
  <div class="field consent">
    <label class="choice consent__label">
      <input id="cf-consent" type="checkbox" name="consent" required aria-describedby="cf-consent-error" />
      <span>{f.consent} <a href={worldUrl("main", "/privacy")}>{f.consentLink}</a>.</span>
    </label>
    <p id="cf-consent-error" class="field__error" hidden></p>
  </div>

  <input type="hidden" name="world" value="research" />
  <input type="hidden" name="formType" value="enquiry" />
  <input type="hidden" name="_subject" value="New message from the Pen of Wonder Research website" />

  <p class="mt-8">
    <button class="btn btn-primary" type="submit">{f.submit}</button>
  </p>
</form>

<style>
  .contact-form {
    max-width: 36rem;
  }
  .field {
    margin-top: 1.5rem;
    border: 0;
    padding: 0;
  }
  .field label,
  .field legend {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .field__hint {
    margin: -0.15rem 0 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="url"],
  .field textarea {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .field [aria-invalid="true"] {
    border-width: 2px;
    border-color: var(--color-text);
  }
  .field__error {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .field__error::before {
    content: "Check this: ";
    font-weight: 400;
  }
  .choices {
    display: grid;
    gap: 0.25rem;
  }
  .field .choice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 400;
    margin: 0;
    cursor: pointer;
  }
  .choice input {
    width: 1.15rem;
    height: 1.15rem;
  }
  .consent__label {
    align-items: flex-start;
    font-size: var(--text-sm);
  }
  .consent__label input {
    flex: none;
    margin-top: 0.15rem;
  }
  .form-summary {
    padding: 0.9rem 1rem;
    border: 2px solid var(--color-text);
    background: var(--color-panel);
    font-weight: 600;
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  type Errors = Record<string, string>;

  const form = document.querySelector<HTMLFormElement>(".contact-form");
  if (form) {
    const errors: Errors = JSON.parse(form.dataset.errors ?? "{}");
    const summary = form.querySelector<HTMLElement>(".form-summary")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonLabel = button.textContent;
    const startedAt = Date.now();
    form.noValidate = true;

    // Each door's button sends people here as ?as=researcher, editing-firm or student.
    const preset = new URLSearchParams(location.search).get("as");
    const presetInput = form.querySelector<HTMLInputElement>(`input[name="service"][value="${CSS.escape(preset ?? "")}"]`);
    if (presetInput) presetInput.checked = true;

    const setError = (id: string, control: HTMLElement | null, message: string | null) => {
      const el = form.querySelector<HTMLElement>(`#${id}-error`);
      if (!el) return;
      el.textContent = message ?? "";
      el.hidden = !message;
      control?.setAttribute("aria-invalid", message ? "true" : "false");
    };

    const validate = () => {
      const name = form.elements.namedItem("name") as HTMLInputElement;
      const email = form.elements.namedItem("email") as HTMLInputElement;
      const message = form.elements.namedItem("message") as HTMLTextAreaElement;
      const link = form.elements.namedItem("file_link") as HTMLInputElement;
      const consent = form.elements.namedItem("consent") as HTMLInputElement;
      const role = form.querySelector<HTMLInputElement>('input[name="service"]:checked');
      const firstRole = form.querySelector<HTMLInputElement>('input[name="service"]');

      const checks: [string, HTMLElement | null, string | null][] = [
        ["cf-name", name, name.value.trim() ? null : errors.name],
        [
          "cf-email",
          email,
          !email.value.trim() ? errors.email : email.validity.typeMismatch ? errors.emailFormat : null,
        ],
        ["cf-role", firstRole, role ? null : errors.role],
        ["cf-message", message, message.value.trim() ? null : errors.message],
        ["cf-link", link, link.value.trim() && !/^https:\/\/\S+\.\S+/.test(link.value.trim()) ? errors.link : null],
        ["cf-consent", consent, consent.checked ? null : errors.consent],
      ];
      checks.forEach(([id, control, msg]) => setError(id, control, msg));
      const firstBad = checks.find(([, , msg]) => msg);
      return firstBad ? (firstBad[1] as HTMLElement) : null;
    };

    const showSummary = (message: string | null) => {
      summary.textContent = message ?? "";
      summary.hidden = !message;
      if (message) summary.focus();
    };

    // Back from a form post without JavaScript that pow-api couldn't accept.
    if (new URLSearchParams(location.search).get("sent") === "error") showSummary(errors.sentError);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const firstBad = validate();
      if (firstBad) {
        showSummary(errors.summary);
        firstBad.focus();
        return;
      }
      if (form.dataset.connected !== "true") {
        showSummary(errors.notConnected);
        return;
      }

      button.disabled = true;
      button.textContent = form.dataset.sending ?? buttonLabel;
      try {
        let response: Response;
        if (form.dataset.backend === "api") {
          const data = Object.fromEntries(new FormData(form).entries());
          response = await fetch(form.action, {
            method: "POST",
            body: JSON.stringify({ ...data, consent: data.consent ? "on" : "", elapsedMs: String(Date.now() - startedAt) }),
            headers: { "Content-Type": "application/json", Accept: "application/json" },
          });
        } else {
          response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        }
        if (!response.ok) {
          const body = (await response.json().catch(() => ({}))) as { error?: string };
          throw new Error(body.error ?? String(response.status));
        }
        location.assign("/contact/thanks");
      } catch (error) {
        const code = error instanceof Error ? error.message : "";
        showSummary(code === "too_fast" ? errors.tooFast : code === "rate_limited" ? errors.rateLimited : code === "invalid" ? errors.summary : errors.network);
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    });
  }
</script>
