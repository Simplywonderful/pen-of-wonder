---
// The top of an inner page. Since the revamp (root DESIGN.md 20, owner's decision 25 Nov 2026) it is
// the family's dark PageHero band; the optional button sits inside the band.
import PageHero from "@pow/ui/PageHero.astro";

interface Props {
  title: string;
  intro?: string;
  cta?: { href: string; label: string };
  eyebrow?: string;
}
const { title, intro, cta, eyebrow } = Astro.props;
const hasExtra = Astro.slots.has("default") || Boolean(cta);
---

{
  hasExtra ? (
    <PageHero title={title} lead={intro} eyebrow={eyebrow}>
      <slot />
      {cta && (
        <a class="btn btn-primary" href={cta.href}>
          {cta.label}
        </a>
      )}
    </PageHero>
  ) : (
    <PageHero title={title} lead={intro} eyebrow={eyebrow} />
  )
}
